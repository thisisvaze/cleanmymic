<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>CleanMyMic</title>
  <options customize="never" require-scripts="false" hostArchitectures="arm64"/>
  <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
  <volume-check><allowed-os-versions><os-version min="15.0"/></allowed-os-versions></volume-check>
  <readme file="ReadMe.html" mime-type="text/html"/>
  <conclusion file="Conclusion.html" mime-type="text/html"/>
  <choices-outline><line choice="default"/></choices-outline>
  <choice id="default" visible="false"><pkg-ref id="dev.vaze.CleanMyMic.pkg"/></choice>
  <pkg-ref id="dev.vaze.CleanMyMic.pkg" onConclusion="RequireRestart">CleanMyMic-component.pkg</pkg-ref>
  <pkg-ref id="dev.vaze.CleanMyMic.pkg"><must-close><app id="dev.vaze.CleanMyMic"/></must-close></pkg-ref>
</installer-gui-script>
